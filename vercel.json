{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/doctor-ui",
      "destination": "/doctor-ui/index.html"
    },
    {
      "source": "/doctor-ui/",
      "destination": "/doctor-ui/index.html"
    },
    {
      "source": "/doctor-ui/:path+",
      "destination": "/doctor-ui/:path+"
    },
    {
      "source": "/chemical",
      "destination": "/chemical/index.html"
    },
    {
      "source": "/chemical/",
      "destination": "/chemical/index.html"
    },
    {
      "source": "/chemical/:path+",
      "destination": "/chemical/:path+"
    },
    {
      "source": "/architect",
      "destination": "/3d-web/architect/index.html"
    },
    {
      "source": "/architect/",
      "destination": "/3d-web/architect/index.html"
    },
    {
      "source": "/architect/:path+",
      "destination": "/3d-web/architect/:path+"
    },
    {
      "source": "/interior",
      "destination": "/3d-web/Interior_DEsign/dist/index.html"
    },
    {
      "source": "/interior/",
      "destination": "/3d-web/Interior_DEsign/dist/index.html"
    },
    {
      "source": "/interior/:path+",
      "destination": "/3d-web/Interior_DEsign/dist/:path+"
    },
    {
      "source": "/pizza",
      "destination": "/3d-web/Pizza-restaurant/dist/index.html"
    },
    {
      "source": "/pizza/",
      "destination": "/3d-web/Pizza-restaurant/dist/index.html"
    },
    {
      "source": "/pizza/:path+",
      "destination": "/3d-web/Pizza-restaurant/dist/:path+"
    },
    {
      "source": "/frames/:path+",
      "destination": "/3d-web/Interior_DEsign/dist/frames/:path+"
    }
  ]
}
